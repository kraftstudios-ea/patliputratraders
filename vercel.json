{
  "version": 2,
  "buildCommand": "node tools/build-pages-site.js .pages-site && node tools/audit-pages.js .pages-site",
  "outputDirectory": ".pages-site",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://brush-production.onrender.com/api/:path*"
    },
    {
      "source": "/shop",
      "destination": "/all_products.html"
    },
    {
      "source": "/shop/",
      "destination": "/all_products.html"
    },
    {
      "source": "/about",
      "destination": "/about_us.html"
    },
    {
      "source": "/about/",
      "destination": "/about_us.html"
    },
    {
      "source": "/contact",
      "destination": "/about_us.html"
    },
    {
      "source": "/contact/",
      "destination": "/about_us.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/checkout/",
      "destination": "/checkout.html"
    },
    {
      "source": "/orders",
      "destination": "/orders.html"
    },
    {
      "source": "/orders/",
      "destination": "/orders.html"
    },
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/profile/",
      "destination": "/profile.html"
    },
    {
      "source": "/policies",
      "destination": "/policies.html"
    },
    {
      "source": "/policies/",
      "destination": "/policies.html"
    },
    {
      "source": "/track",
      "destination": "/track.html"
    },
    {
      "source": "/track/",
      "destination": "/track.html"
    },
    {
      "source": "/order-confirmation",
      "destination": "/order-confirmation.html"
    },
    {
      "source": "/order-confirmation/",
      "destination": "/order-confirmation.html"
    },
    {
      "source": "/build-pack",
      "destination": "/build-pack.html"
    },
    {
      "source": "/digital-assets",
      "destination": "/digital-assets.html"
    },
    {
      "source": "/special-day",
      "destination": "/special_day.html"
    },
    {
      "source": "/style-options",
      "destination": "/style_options.html"
    },
    {
      "source": "/institutional",
      "destination": "/institutional.html"
    }
  ],
  "headers": [
    {
      "source": "/(robots\\.txt|llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(img|assets|Fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
