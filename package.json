{
  "name": "patliputra-traders",
  "version": "1.0.0",
  "private": true,
  "description": "Patliputra Traders — Luxury Lighting & Modern Chandeliers",
  "scripts": {
    "postinstall": "node -e \"if (require('fs').existsSync('./Backend/package.json')) require('child_process').execSync('npm --prefix Backend install', {stdio:'inherit'})\"",
    "build": "node tools/build-pages-site.js .pages-site && node tools/audit-pages.js .pages-site",
    "serve:build": "npx -y http-server .pages-site -a 0.0.0.0 -p 9000 -c-1",
    "dev:backend": "cd Backend && node server.js",
    "dev:frontend": "node scripts/serve-frontend.js",
    "seed:lighting": "cd Backend && node scripts/seed-lighting-products.js",
    "start": "node server.js"
  }
}
