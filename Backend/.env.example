# =============================================================
# Brush Backend — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.
# =============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5500
SITE_URL=https://brush-art.in

# ── MongoDB Atlas ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Local development only: when Razorpay can't be reached, fake a successful
# online payment instead of refusing it. NEVER set this in production.
# ALLOW_MOCK_PAYMENTS=true

# ── Firebase (image storage) ───────────────────────────────
# Place your serviceAccountKey.json in the Backend/ directory.
# The file path is hardcoded in server.js as ./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ── Email (Nodemailer / SMTP) ──────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
EMAIL_FROM="Brush <orders.master@brush-art.in>"
EMAIL_REPLY_TO=admin@brush-art.in
EMAIL_CC=admin@brush-art.in
EMAIL_BCC=kumarmangalam.patna@gmail.com

# ── Admin Setup (used by setupAdmin.js) ────────────────────
SETUP_ADMIN_USERNAME=admin
SETUP_ADMIN_PASSWORD=change-me-immediately

# --- Qikink (print-on-demand fulfilment) ---
# Sandbox: https://sandbox.qikink.com   Live: https://api.qikink.com
# ClientId is the same for both; client_secret differs. Both come from
# dashboard.qikink.com -> Integration -> Custom API.
QIKINK_BASE_URL=https://sandbox.qikink.com
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
# Enables the loopback-only GET /api/_qikink/diagnose route. Keep false.
QIKINK_DIAGNOSTICS=false
RAZORPAY_WEBHOOK_SECRET=

# Direct transfer (UPI / bank) — the interim prepaid route used while the
# payment gateway is being activated. Leave DIRECT_PAY_ENABLED unset to hide
# the option entirely. Only fill the fields you actually want shown.
DIRECT_PAY_ENABLED=
DIRECT_PAY_UPI_VPA=
DIRECT_PAY_PAYEE_NAME=
DIRECT_PAY_BANK_NAME=
DIRECT_PAY_ACCOUNT_NAME=
DIRECT_PAY_ACCOUNT_NUMBER=
DIRECT_PAY_IFSC=
DIRECT_PAY_QR_PATH=
